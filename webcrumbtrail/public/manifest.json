{
  "manifest_version": 3,
  "name": "WebCrumbTrail",
  "version": "0.1.0",
  "description": "Local-first trail of visits to allowlisted domains with optional manual summaries.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "WebCrumbTrail"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "tabs", "windows", "scripting", "contextMenus", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ollama_local_origin",
        "enabled": true,
        "path": "rules/ollama_cors.json"
      }
    ]
  },
  "incognito": "split"
}
